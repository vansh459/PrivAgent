{
  "name": "privagent",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-preserving browser agent monorepo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --prefix extension\" \"node scripts/run-server.mjs\"",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "check:schemas": "node scripts/gen-schemas.mjs --check",
    "verify:structure": "node scripts/verify-structure.mjs",
    "lint": "npm run lint --prefix extension",
    "typecheck": "npm run typecheck --prefix extension",
    "format:check": "npm run format:check --prefix extension",
    "build": "npm run verify:structure && npm run vendor:assets && npm run build --prefix extension",
    "test:extension": "npm run test:coverage --prefix extension",
    "test:server": "node scripts/run-server-tests.mjs",
    "test": "npm run check:schemas && npm run lint && npm run typecheck && npm run format:check && npm run test:extension && npm run test:server",
    "vendor:assets": "node scripts/vendor-assets.mjs",
    "test:reasoner": "node scripts/run-server-tests.mjs --live",
    "dataset:capture": "node scripts/capture-dataset.mjs",
    "dataset:annotate": "node scripts/annotate-dataset.mjs",
    "eval:dataset": "npm run test:e2e --prefix extension -- e2e/dataset.spec.ts",
    "eval:profile": "npm run test:e2e --prefix extension -- e2e/profile.spec.ts",
    "demo:rehearse": "npm run test:e2e --prefix extension -- e2e/demo.spec.ts",
    "package:firefox": "npm run package:firefox --prefix extension"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  }
}
