# PrivAgent server configuration - copy to .env (untracked) and fill in.
#
# Provider selection. "deterministic" (default) needs nothing; "ollama" is the
# offline open-source model used for every rubric measurement and the judged demo;
# "foundry" is the OPTIONAL remote brain for universal multi-step browsing - the
# sanitized, tokenized context is sent to YOUR Azure deployment when selected.
PRIVAGENT_REASONER=deterministic

# PRIVAGENT_REASONER=ollama
PRIVAGENT_OLLAMA_MODEL=qwen2.5:1.5b
PRIVAGENT_OLLAMA_URL=http://127.0.0.1:11434

# PRIVAGENT_REASONER=foundry  (Anthropic Messages API on Azure AI Foundry)
# The key belongs ONLY here or in the process environment - never in code, never
# committed. Rotate it if it has ever appeared in a chat, log, or commit.
PRIVAGENT_FOUNDRY_BASE_URL=https://<your-resource>.services.ai.azure.com/anthropic
PRIVAGENT_FOUNDRY_API_KEY=
PRIVAGENT_FOUNDRY_MODEL=claude-fable-5
